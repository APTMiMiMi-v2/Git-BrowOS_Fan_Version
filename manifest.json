{
	"manifest_version": 1,
	"name": "Git-BrowOS Fan Version",
	"version": "1.0.0",
	"description": "BrowOS Inside GitHub But Fan Version. Turns your new tab into a desktop OS with windows, a Start menu, a taskbar, built-in apps, BrowStore and custom wallpapers.",
	"icons": {
		"16": "icons/Git-BrowOS_Logo.png",
		"32": "icons/Git-BrowOS_Logo.png",
		"48": "icons/Git-BrowOS_Logo.png",
		"128": "icons/Git-BrowOS_Logo.png"
	},
	"chrome_url_overrides": {
		"newtab": "https://aptmimimi-v2.github.io/Git-BrowOS_Fan_Version/"
	},
	"permissions": [
		"storage"
	],
	"optional_permissions": [
		"bookmarks"
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "browos@browos.invalid",
			"strict_min_version": "115.0"
		}
	}
}
